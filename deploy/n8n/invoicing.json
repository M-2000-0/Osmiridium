{
  "name": "Invoicing (Osmiridium)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "weeks", "triggerAtHour": 9, "triggerAtMinute": 0 }] },
        "options": {}
      },
      "id": "n1-invoice-schedule",
      "name": "Weekly trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://osmiridium.example.com/sessions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-api-key", "value": "YOUR_OSMIRIDIUM_API_KEY" }]
        },
        "options": {}
      },
      "id": "n2-invoice-fetch",
      "name": "Fetch usage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-total",
              "leftValue": "={{ $json.total }}",
              "rightValue": "",
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n3-invoice-if",
      "name": "Amount due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "operation": "send",
        "fromEmail": "billing@osmiridium.tech",
        "toEmail": "={{ $json.customerEmail || 'billing@osmiridium.tech' }}",
        "subject": "Invoice for Osmiridium usage",
        "emailFormat": "text",
        "text": "Hi {{ $json.customerName || 'there' }},\\n\\nHere is your invoice:\\nTotal: ${{ $json.total }}\\n\\nPay here: {{ $json.paymentLink }}\\n\\nThanks,\\nThe Osmiridium team",
        "options": {}
      },
      "id": "n4-invoice-send",
      "name": "Send invoice",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [660, 0],
      "credentials": {
        "smtp": { "id": "SMTP_CREDENTIAL_ID", "name": "SMTP account" }
      }
    }
  ],
  "connections": {
    "Weekly trigger": { "main": [[{ "node": "Fetch usage", "type": "main", "index": 0 }]] },
    "Fetch usage": { "main": [[{ "node": "Amount due?", "type": "main", "index": 0 }]] },
    "Amount due?": { "main": [[{ "node": "Send invoice", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}