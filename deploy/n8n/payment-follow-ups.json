{
  "name": "Payment Follow-ups (Osmiridium)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 8, "triggerAtMinute": 0 }] },
        "options": {}
      },
      "id": "n1-follow-schedule",
      "name": "Daily trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.stripe.com/v1/invoices?status=open&limit=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "n2-follow-list",
      "name": "List open invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "overdue",
              "leftValue": "={{ $json.daysUntilDue }}",
              "rightValue": "",
              "operator": { "type": "number", "operation": "lte" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n3-follow-if",
      "name": "Overdue?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "fromEmail": "billing@osmiridium.tech",
        "toEmail": "={{ $json.customerEmail }}",
        "subject": "Reminder: invoice {{ $json.number }} is due",
        "emailFormat": "text",
        "text": "Hi,\\n\\nThis is a reminder that invoice {{ $json.number }} for ${{ $json.amountDue }} is due soon.\\n\\nPay here: {{ $json.hostedInvoiceUrl }}\\n\\nThanks,\\nThe Osmiridium team",
        "options": {}
      },
      "id": "n4-follow-send",
      "name": "Send reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [660, 0],
      "credentials": {
        "smtp": { "id": "SMTP_CREDENTIAL_ID", "name": "SMTP account" }
      }
    }
  ],
  "connections": {
    "Daily trigger": { "main": [[{ "node": "List open invoices", "type": "main", "index": 0 }]] },
    "List open invoices": { "main": [[{ "node": "Overdue?", "type": "main", "index": 0 }]] },
    "Overdue?": { "main": [[{ "node": "Send reminder", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}