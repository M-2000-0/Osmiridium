# Osmiridium deployment configuration.
# Copy to .env and fill in real values before exposing publicly.

# Coordinator
OSMOSMPC_API_KEY=changeme
OSMOSMPC_RATE_LIMIT=60
API_PORT=8080
RUST_LOG=osmiridium=info

# Image registry (for --pull deploys)
# IMAGE_NAMESPACE=M-2000-0/Osmiridium
# GHCR_USER=your-github-user
# GHCR_TOKEN=your-github-token

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000